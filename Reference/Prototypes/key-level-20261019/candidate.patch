+        '// Public helper inputs are bounded to the plugin MIDI and documented TL domain.',
+        'inline constexpr int clamp(int value, int lo, int hi) noexcept {',
+        '    return value < lo ? lo : value > hi ? hi : value;',
+        '}',
+        'inline constexpr int offset(int midi, int lks) noexcept {',
