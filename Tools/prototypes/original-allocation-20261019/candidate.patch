+int main(int argc,char** argv){try{
+ if(argc<2||argc>3)throw std::runtime_error("output.bin [explicit-legacy]");
+ if(std::ifstream(argv[1]).good())throw std::runtime_error("Refuse existing output");
+ const bool explicitLegacy=argc==3&&std::string(argv[2])=="explicit-legacy";
+ if(argc==3&&!explicitLegacy)throw std::runtime_error("Unknown probe option");
+ std::ofstream out(argv[1],std::ios::binary);if(!out)throw std::runtime_error("Open failure");
+ std::uint64_t frames=0;int cases=0;
+ auto select=[&](press78::Controls& c){
+#ifdef ALLOCATION_CANDIDATE
+  if(explicitLegacy)c.allocationModel=0;
+#else
+  (void)c;(void)explicitLegacy;
+#endif
+ };
+ auto block=[&](press78::Press78Engine& e,int count){std::array<float,256>l{},r{};while(count>0){int n=std::min(count,256);e.process(l.data(),r.data(),static_cast<std::size_t>(n));for(int i=0;i<n;++i){if(!std::isfinite(l[i])||!std::isfinite(r[i]))throw std::runtime_error("Nonfinite probe");out.write(reinterpret_cast<const char*>(&l[i]),4);out.write(reinterpret_cast<const char*>(&r[i]),4);}frames+=static_cast<std::uint64_t>(n);count-=n;}const auto active=static_cast<std::uint32_t>(e.activeVoices());out.write(reinterpret_cast<const char*>(&active),4);};
+ for(double rate:{44100.,48000.,96000.})for(const auto& factory:press78::kFactoryVoices){
+  auto e=std::make_unique<press78::Press78Engine>();e->prepare(rate);auto patch=press78::decodeVoice(factory.bytes);e->setPatch(patch);
+  press78::Controls c;c.masterGain=.12;c.pitchModel=(factory.number/2)%2;c.sustainMode=factory.number%2;c.chorusMode=1;c.chorusMix=.8;c.clockDriftPpm=20;c.drive=0;select(c);e->setControls(c);
+  int note=48+factory.number%36;e->noteOn(note,80+factory.number%48,0);block(*e,1);e->noteOn(note,99,0);e->noteOn(note,77,1);block(*e,127);
+  e->noteOff(note,0);e->sustainController(127);block(*e,64);e->noteOff(note,1);block(*e,257);
+  c.pitchBendSemitones=(factory.number%9-4)*.125;c.masterTuneCents=.4*factory.number;e->setControls(c);patch.feedback=(patch.feedback+1)%8;e->setPatch(patch,factory.number%2);block(*e,389);
+  c.polyphony=2;e->setControls(c);for(int i=0;i<15;++i)e->noteOn(48+i,100,i%2);block(*e,128);c.polyphony=12;e->setControls(c);e->allNotesOff();e->sustainController(0);block(*e,512);e->allSoundOff();block(*e,64);++cases;
+ }
+ // Direct-core rate/clock-boundary probes also exercise the complete retained
+ // history span. These are compatibility checks, not hardware calibration.
+ for(double rate:{8000.,44100.,48000.,96000.,192000.})for(double offset:{-20000.,0.,20000.})for(int preset:{-1,93}){
+  auto e=std::make_unique<press78::Press78Engine>();e->prepare(rate);e->setPatch(preset<0?press78::initPatch():press78::decodeVoice(press78::kFactoryVoices[93].bytes));
+  press78::Controls c;c.masterGain=.12;c.pitchModel=1;c.sustainMode=1;c.clockOffsetPpm=offset;c.clockDriftPpm=10000;c.clockDriftRateHz=2.;c.outputCircuit=true;c.chorusMode=1;c.chorusMix=1;select(c);e->setControls(c);e->noteOn(127,111,0);e->noteOn(36,99,1);
+  block(*e,static_cast<int>(std::llround(rate*.3)));e->noteOff(127,0);e->noteOff(36,1);block(*e,257);e->process(nullptr,nullptr,37);block(*e,129);++cases;
+ }
+ if(!out)throw std::runtime_error("Write failure");out.close();
+ std::printf("{\"cases\":%d,\"frames\":%llu,\"explicit_legacy\":%s}\n",cases,static_cast<unsigned long long>(frames),explicitLegacy?"true":"false");return 0;
+}catch(const std::exception& e){std::fprintf(stderr,"%s\n",e.what());return 1;}}
